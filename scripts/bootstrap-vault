#!/bin/sh
# Create the toolbox notebook. Missing files only. Does not overwrite notes.
# Usage: bootstrap-vault [DEST]
# DEST defaults to ./notebook
set -eu

dest=${1:-./notebook}

mkdir -p "$dest/tools" "$dest/toolchains" "$dest/inbox" "$dest/.obsidian"

if [ ! -f "$dest/.obsidian/app.json" ]; then
  printf '%s\n' '{' \
    '  "legacyEditor": false,' \
    '  "livePreview": true' \
    '}' > "$dest/.obsidian/app.json"
fi

if [ ! -f "$dest/toolchains/Index.md" ]; then
  printf '%s\n' '# Toolchains' '' 'Empty until a chain survives a detect.' > "$dest/toolchains/Index.md"
fi

if [ ! -f "$dest/inbox/README.md" ]; then
  printf '%s\n' '# Inbox' '' 'Packets land here. Files stay on disk. The packet names them.' > "$dest/inbox/README.md"
fi

if [ ! -f "$dest/tools/seed.md" ]; then
  cat > "$dest/tools/seed.md" << 'EOF'
# seed

The seed tools are not in this folder. They live in Mesh-Node/mesh-node.

Confirm them. Do not copy them.

- lan-probe
- write-packet
- send-file
- recv-file
- send-http

Packet: who, what, files. Files stay on disk.
EOF
fi

if [ ! -f "$dest/tools/exact-word.md" ]; then
  cat > "$dest/tools/exact-word.md" << 'EOF'
# exact-word

Hit or miss. No fingerprint.

Same words, same file, same lines.
A typo is a miss. Empty is correct.

```
../scripts/exact-word BOOK WORDS...
```

See the exact-word playbook before you add a score.
EOF
fi

if [ ! -f "$dest/Index.md" ]; then
  cat > "$dest/Index.md" << 'EOF'
# Index

This notebook is the toolbox.

## Folders

- inbox — packets
- tools — one note per tool
- toolchains — empty until a chain survives

## Base

- [[seed]]
- [[exact-word]]

Open a tool note. Then run the script it names.
EOF
fi

echo "PASS notebook $dest"
